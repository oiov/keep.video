# 复制到仓库根目录 .env；不得提交真实凭据。
SITE_URL=https://keep.video
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FILE_TTL_HOURS=24
WEB_CONCURRENCY=3
WEB_MAX_QUEUED=30
WEB_SESSION_TASKS=10
WEB_PARSE_HOURLY_LIMIT=60
WEB_PARSE_DAILY_LIMIT=200
WEB_DOWNLOAD_DAILY_LIMIT=30
MAX_FILE_MB=2048
TASK_TIMEOUT_MINUTES=60
ANALYTICS_ENABLED=1
ANALYTICS_ENVIRONMENT=production
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_MAX_DAILY_MB=16
# 留空关闭 /see；启用时设置至少 16 字符的高强度随机密码，仅服务端读取。
# 非本地 SITE_URL 必须使用 HTTPS；改密码后重新创建容器，旧会话随之失效。
SEE_PASSWORD=
